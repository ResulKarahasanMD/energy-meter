# Copy this file to secrets.yaml and replace every value. secrets.yaml is ignored by git.
wifi_ssid: "CHANGE_ME_WIFI_SSID"
wifi_password: "CHANGE_ME_WIFI_PASSWORD"
# Password of the fallback access point the device opens when it cannot join Wi-Fi (8+ characters).
fallback_ap_password: "CHANGE_ME_FALLBACK_AP_PASSWORD"
# 32-byte base64 key, generate with:  openssl rand -base64 32
api_encryption_key: "CHANGE_ME_BASE64_32_BYTE_KEY"
